DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect requests for generated HTML files. Leave internal rewrites alone.
    RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s])
    RewriteRule ^index\.html$ https://clevanoo.com/ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html(?:[?\s])
    RewriteRule ^(about|services|zendesk|industries|jobs|contact|faq|unsubscribe-email)\.html$ https://clevanoo.com/$1 [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+zendesk-case-studies\.html(?:[?\s])
    RewriteRule ^zendesk-case-studies\.html$ https://clevanoo.com/case-studies [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+specialities\.html(?:[?\s])
    RewriteRule ^specialities\.html$ https://clevanoo.com/speciality [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+job-upload\.html(?:[?\s])
    RewriteRule ^job-upload\.html$ https://clevanoo.com/jobUpload [R=301,L]

    # Use the clean route and canonical host in the same redirect.
    RewriteRule ^(about|services|zendesk|industries|jobs|contact|faq|unsubscribe-email|case-studies|speciality|job/[1-9][0-9]*)/$ https://clevanoo.com/$1 [R=301,L]
    RewriteCond %{REQUEST_URI} !^/jobUpload$
    RewriteRule ^jobUpload/?$ https://clevanoo.com/jobUpload [R=301,L,NC]

    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.clevanoo\.com(?::[0-9]+)?$ [NC]
    RewriteRule ^ https://clevanoo.com%{REQUEST_URI} [R=301,L]

    # Let Laravel's own rules handle backend requests.
    RewriteRule ^backend(?:/|$) - [L]

    # Serve the generated page for each clean URL.
    RewriteRule ^jobUpload/?$ job-upload.html [END,NC]
    RewriteRule ^(about|services|zendesk|industries|contact|faq|unsubscribe-email)/?$ $1.html [END]
    RewriteRule ^case-studies/?$ zendesk-case-studies.html [END]
    RewriteRule ^speciality/?$ specialities.html [END]
    RewriteRule ^(?:jobs|job/[1-9][0-9]*|jobs-sitemap\.xml)$ backend/public/index.php [END]
</IfModule>
